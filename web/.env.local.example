# Copy to .env.local (already gitignored) and fill in to enable the real
# J.A.R.V.I.S. backend. Without these, the app automatically runs on the
# local keyword-router fallback — no crash, no fake responses.

# Gemini needs no key here: in this dev environment it's a network-level
# credential injected by the proxy into the Authorization: Bearer header.
# On a real deployment (Vercel etc.), set GEMINI_API_KEY as a real secret
# and change lib/gemini.ts to send `Authorization: Bearer ${key}` instead
# of the "proxy-injected" placeholder.
# Set to "1" to force the local keyword-router fallback even if a
# Gemini credential is available.
GEMINI_DISABLE=
# Voice widget (/api/jarvis-voice) and the host's real key. Set on Vercel as a secret too.
GEMINI_API_KEY=
# Optional — the voice route defaults to gemini-2.5-flash
GEMINI_MODEL=

# ElevenLabs voice for J.A.R.V.I.S. replies (/api/jarvis-tts). Without these the widget uses the browser's voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set to 1 to never call ElevenLabs (zero cost): the widget then uses the free browser voice.
ELEVENLABS_DISABLE=
# Optional — defaults to eleven_flash_v2_5
ELEVENLABS_MODEL=

# Contact form: leads are emailed through Resend (https://resend.com). Set these in Vercel, never in code.
RESEND_API_KEY=
# Comma-separated recipients (default hello.studionavya@gmail.com). Until a domain is verified in Resend, only the
# email address of the Resend account itself can receive mail from the free sender.
LEAD_TO_EMAIL=
# Optional sender, e.g. "Studio Navya <leads@yourdomain.com>" once that domain is verified in Resend.
LEAD_FROM_EMAIL=

# n8n webhook URLs (Production URL from each workflow's Webhook trigger node).
# Each is independent — J.A.R.V.I.S. tells the visitor honestly if one is
# missing or times out, rather than pretending the action succeeded.
N8N_LEAD_WEBHOOK_URL=
N8N_CALENDAR_WEBHOOK_URL=
N8N_DOSSIER_WEBHOOK_URL=
